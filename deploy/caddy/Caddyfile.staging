{
	# The site access log has its own filtered file sink below. Caddy may also
	# emit HTTP records through its default process logger, which systemd sends
	# to journald. Keep those records useful while removing every request value.
	log default {
		format filter {
			user_id delete
			request>remote_ip hash
			request>client_ip hash
			request>uri delete
			request>headers delete
			resp_headers delete
			wrap json
		}
	}
}

careertrellis.jhunterj.com {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# Exact public feedback resources require no referrer, including same-origin.
	# Disjoint matchers avoid competing deferred writes from security headers.
	@feedbackReferrer path /feedback /static/feedback.css /static/feedback.js
	header @feedbackReferrer >Referrer-Policy "no-referrer"
	# Preserve existing same-origin form behavior on all other paths.
	@otherReferrer {
		not path /feedback /static/feedback.css /static/feedback.js
	}
	header @otherReferrer >Referrer-Policy "same-origin"

	reverse_proxy 127.0.0.1:8001 {
		# Overwrite any client-supplied value with the root-owned origin secret.
		header_up X-CareerTrellis-Proxy-Token {$CAREERTRELLIS_TRUSTED_PROXY_TOKEN}
		health_uri /health/ready
		health_interval 30s
		health_timeout 5s
		transport http {
			dial_timeout 3s
			response_header_timeout 300s
		}
	}

	log {
		output file /var/log/caddy/careertrellis-staging-access-v7.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			user_id delete
			request>remote_ip hash
			request>client_ip hash
			# Delete whole maps so new or renamed header fields cannot escape.
			request>headers delete
			resp_headers delete
			wrap json
		}
	}

	# Authentication paths may carry identity-provider state, callback material,
	# recovery context, or session transitions. Keep every /auth route out of the
	# access log rather than relying on a growing path-by-path denylist.
	log_skip /auth*
}

# Candidate only: validate against the fresh live configuration before deployment.
staging-app.jhunterj.com {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Cache-Control "no-store"
    }

    # An explicit route preserves order. Never forward callback queries or POSTs.
    route {
        @oldAuth path /auth*
        handle @oldAuth {
            header Content-Type "text/html; charset=utf-8"
            respond "<!doctype html><html lang='en'><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>CareerTrellis has moved</title><main><h1>CareerTrellis has moved</h1><p>This sign-in attempt ended because our address changed. Please sign in again at our new address.</p><p><a href='https://careertrellis.jhunterj.com/'>Sign in to CareerTrellis</a></p></main></html>" 200
        }
        @oldApi path /api /api/*
        handle @oldApi {
            respond "CareerTrellis has moved. Open https://careertrellis.jhunterj.com/ and sign in again. This request was not processed." 409
        }
        @navigation method GET HEAD
        handle @navigation {
            # Preserve path only, intentionally discard query parameters.
            redir https://careertrellis.jhunterj.com{path} 302
        }
        handle {
            respond "CareerTrellis has moved. Open https://careertrellis.jhunterj.com/ and sign in again. This request was not processed." 409
        }
    }
    # No site access log on the retired hostname; global logger strips URI/headers.
}
