[Unit]
Description=CareerTrellis staging worker scaffold
After=network-online.target
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/careertrellis/staging/current

[Service]
Type=simple
User=careertrellis
Group=careertrellis
WorkingDirectory=/opt/careertrellis/staging/current/backend
EnvironmentFile=/etc/careertrellis/staging.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/careertrellis/staging/current/backend/venv/bin/python worker.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/careertrellis/staging
TasksMax=64
MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
