[Unit]
Description=Check authenticator cleanup cadence and alerts (%i)

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/bin/bash /opt/careertrellis/staging/releases/%i/deploy/scripts/manage-totp-cleanup.sh monitor
TimeoutStartSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ReadWritePaths=/run/lock
ReadWritePaths=/var/lib/careertrellis/totp-cleanup
StandardOutput=journal
StandardError=journal
