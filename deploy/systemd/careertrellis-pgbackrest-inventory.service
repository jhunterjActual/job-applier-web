[Unit]
Description=Download-verified PostgreSQL recovery-mirror inventory
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=careertrellis-backup-health-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/careertrellis-check-pgbackrest-mirror
ExecStartPost=/usr/local/sbin/careertrellis-backup-health clear-unit-alert %n
TimeoutStartSec=12h
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
# The trusted root wrapper must perform one fixed UID/GID drop. Keep every
# non-syscall-filter boundary and tightly bound its root capabilities.
PrivateDevices=false
DevicePolicy=closed
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_SETGID CAP_SETUID
ProtectHome=true
ProtectSystem=strict
ProtectHostname=false
ProtectClock=false
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectKernelLogs=false
ProtectControlGroups=true
RestrictNamespaces=false
# The trusted root wrapper drops to postgres with setpriv. Keep
# NoNewPrivileges, but do not combine it with RestrictSUIDSGID's incompatible
# syscall filter on this identity-transition unit.
RestrictSUIDSGID=false
LockPersonality=false
ReadWritePaths=/etc/careertrellis
ReadWritePaths=/run/lock
ReadWritePaths=/var/backups/careertrellis/backup-health
ReadWritePaths=/var/lib/careertrellis/backup-health
ReadWritePaths=/var/log/pgbackrest
ReadWritePaths=/var/spool/pgbackrest

[Install]
WantedBy=multi-user.target
