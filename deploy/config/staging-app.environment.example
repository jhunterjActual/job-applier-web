# Root-owned systemd EnvironmentFile for the application services.
# Install as /etc/careertrellis/staging.env with mode 0600.
CAREERTRELLIS_ENVIRONMENT=staging
CAREERTRELLIS_ALLOWED_HOSTS=careertrellis.jhunterj.com
CAREERTRELLIS_DATA_DIR=/var/lib/careertrellis/staging
CAREERTRELLIS_TRUSTED_PROXY_TOKEN=replace-with-the-same-64-character-random-value-used-by-caddy
PLAYWRIGHT_BROWSERS_PATH=/var/lib/careertrellis/shared/ms-playwright

# Required by the Stage 2 web release. Keep every value in this root-owned
# mode-0600 file; never commit real WorkOS values.
CAREERTRELLIS_AUTH_MODE=workos
CAREERTRELLIS_IDENTITY_STORE=postgres
# Required by the final PostgreSQL/R2 cutover candidate. Install this exact
# selection only as part of the reviewed coordinator workflow; the pre-cutover
# authority guard prevents ordinary activation of this final-capable release.
CAREERTRELLIS_DATA_STORE=postgres
# These web-side producer gates must exactly match their dedicated worker files.
# Keep a feature unavailable when its durable consumer is disabled.
CAREERTRELLIS_SEARCH_WORKER_ENABLED=false
CAREERTRELLIS_ACCOUNT_ERASURE_WORKER_ENABLED=false
WORKOS_API_KEY=replace-with-the-staging-workos-api-key
WORKOS_CLIENT_ID=replace-with-the-staging-workos-client-id
WORKOS_COOKIE_PASSWORD=replace-with-a-url-safe-base64-key-from-32-random-bytes
WORKOS_REDIRECT_URI=https://careertrellis.jhunterj.com/auth/callback
WORKOS_LOGOUT_RETURN_TO=https://careertrellis.jhunterj.com/
CAREERTRELLIS_STAGING_OWNER_WORKOS_USER_ID=replace-with-the-approved-immutable-workos-user-id

# CAREERTRELLIS_DATABASE_URL is loaded separately from the root-owned
# /etc/careertrellis/postgres-runtime.env credential bundle.
# Encrypted provider-secret settings and keys are loaded separately from
# /etc/careertrellis/provider-secrets.env. Never put those keys in this file.

# Optional privacy-minimized monitoring; leave blank to disable.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0
