# Root-owned systemd EnvironmentFile for encrypted per-user provider secrets.
# Install as /etc/careertrellis/provider-secrets.env with root:root mode 0600.
CAREERTRELLIS_PROVIDER_SECRET_STORE=postgres_encrypted
CAREERTRELLIS_PROVIDER_SECRET_ACTIVE_KEY_ID=kek-2026-08-12-a

# URL-safe base64 of compact JSON whose values are URL-safe base64-encoded
# 32-byte AES keys. Keep old keys during rotation until every row has been
# re-encrypted with the active key. This example decodes to a placeholder only.
CAREERTRELLIS_PROVIDER_SECRET_KEYRING_B64=replace-with-base64url-encoded-keyring-json
