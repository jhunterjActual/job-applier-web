[Unit]
Description=Monday-Saturday guarded complete OneDrive backup bundles

[Timer]
# After the normal 03:15 UTC R2 cycle; Sunday uses the existing paired window.
# Requires an accepted policy with matching explicit schedule_days and 06 UTC.
OnCalendar=Mon..Sat *-*-* 06:00:00 UTC
RandomizedDelaySec=15m
Persistent=true
Unit=careertrellis-onedrive-retention.service

[Install]
WantedBy=timers.target
