[Unit]
Description=Evaluate PostgreSQL backup and recovery health
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=careertrellis-backup-health-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/careertrellis-backup-health evaluate
ExecStartPost=/usr/local/sbin/careertrellis-backup-health clear-unit-alert %n
SuccessExitStatus=1
TimeoutStartSec=10m
NoNewPrivileges=true
PrivateTmp=true
# PrivateDevices implies a syscall filter that rejects this unit's fixed
# setpriv transition. Preserve physical-device denial and remove raw-device
# capabilities without that incompatible filter.
PrivateDevices=false
DevicePolicy=closed
CapabilityBoundingSet=~CAP_MKNOD CAP_SYS_RAWIO
ProtectHome=true
ProtectSystem=strict
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
# The trusted root wrapper drops to postgres with setpriv. Keep
# NoNewPrivileges, but do not combine it with RestrictSUIDSGID's incompatible
# syscall filter on this identity-transition unit.
RestrictSUIDSGID=false
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/run/lock
ReadWritePaths=/var/backups/careertrellis/backup-health
ReadWritePaths=/var/lib/careertrellis/backup-health
ReadWritePaths=/var/log/pgbackrest
ReadWritePaths=/var/spool/pgbackrest
