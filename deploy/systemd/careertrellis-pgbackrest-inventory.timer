[Unit]
Description=Weekly download-verified PostgreSQL recovery-mirror inventory

[Timer]
# A relative activation delay postpones verification whenever the timer or host
# restarts. Keep a UTC calendar schedule and catch one missed occurrence.
OnCalendar=Thu *-*-* 06:00:00 UTC
Persistent=true
RandomizedDelaySec=30m
Unit=careertrellis-pgbackrest-inventory.service

[Install]
WantedBy=timers.target
