[Unit]
Description=CareerTrellis staging web service
After=network-online.target
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/careertrellis/staging/current

[Service]
Type=simple
User=careertrellis
Group=careertrellis
WorkingDirectory=/opt/careertrellis/staging/current/backend
EnvironmentFile=/etc/careertrellis/staging.env
EnvironmentFile=/etc/careertrellis/postgres-runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/careertrellis/staging/current/backend/venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header --no-access-log --limit-concurrency 32 --backlog 64 --timeout-graceful-shutdown 30
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/careertrellis/staging
TasksMax=256
MemoryHigh=1100M
MemoryMax=1400M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
